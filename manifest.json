{
  "manifest_version": 3,
  "name": "KEXP Skip Buttons",
  "version": "2.0.0",
  "description": "Adds Skip Song and Skip Block buttons to KEXP.org that mute the stream until the next song or the next block.",
  "content_scripts": [
    {
      "matches": ["*://*.kexp.org/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
